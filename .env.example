# Supabase: open your project → click "Connect" (top of dashboard) → copy URLs from the modal.
# Use Transaction pool for DATABASE_URL; Direct (db.*.supabase.co:5432) for DIRECT_URL.
# See README "Deploy (Vercel + Supabase)" if the UI labels differ.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres?sslmode=require"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL="https://YOUR_PUBLIC_HOST"

# Optional: HubSpot deal sync
HUBSPOT_PRIVATE_APP_TOKEN=

# Optional: AI intake / chat
CLA_ANTHROPIC_KEY=

# Optional: allow dealer embed iframe on partner portals (space-separated origins)
DEALER_EMBED_FRAME_ANCESTORS=
